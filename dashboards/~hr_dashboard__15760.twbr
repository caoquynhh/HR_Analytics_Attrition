  <worksheets>
    <worksheet name='Attrition Risk Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#f1ce63' fontname='Tableau Bold' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='WA_Fn-UseC_-HR-Employee-Attriti (Data sau xử lý)' name='federated.1vb3wkh14cl6ws15iny691sp7f6z' />
          </datasources>
          <datasource-dependencies datasource='federated.1vb3wkh14cl6ws15iny691sp7f6z'>
            <column datatype='string' name='[Attrition]' role='dimension' type='nominal' />
            <column caption='Attrition count' datatype='integer' name='[Calculation_2118265449402368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Attrition] = &apos;Yes&apos; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Attrition rate' datatype='real' name='[Calculation_2118265450119170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2118265449402368])/SUM([EmployeeCount])' />
            </column>
            <column caption=' Years at Company Group' datatype='string' name='[Calculation_2118265574985740]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [YearsAtCompany] &lt;= 1 then &quot;0-1 years&quot;&#13;&#10;ELSEIF [YearsAtCompany] &lt;= 3 then &quot;1-3 years&quot;&#13;&#10;ELSEIF [YearsAtCompany] &lt;= 5 then &quot;3-5 years&quot;&#13;&#10;ELSEIF [YearsAtCompany] &lt;= 10 then &quot;5-10 years&quot;&#13;&#10;ELSE &quot;10+ years&quot;&#13;&#10;END' />
            </column>
            <column caption='Midpoint_JobLevel' datatype='real' name='[Calculation_2118266742251553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [JobLevel] : MEDIAN([MonthlyIncome])}' />
            </column>
            <column caption='Compa_Ratio' datatype='real' name='[Calculation_2118266742407202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[MonthlyIncome]/[Calculation_2118266742251553]' />
            </column>
            <column caption='Compa_Ratio_Group' datatype='string' name='[Calculation_2118266742579235]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2118266742407202] &lt; 0.8 THEN &quot;Below Standard&quot;&#13;&#10;ELSEIF [Calculation_2118266742407202] &lt;= 1.2 THEN &quot;Competitive&quot;&#13;&#10;ELSE &quot;Above Standard&quot;&#13;&#10;END' />
            </column>
            <column caption='Compa_Ratio_Group_Sort' datatype='integer' name='[Calculation_2118266743230500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_2118266742407202] &lt; 0.8 THEN 1&#13;&#10;ELSEIF [Calculation_2118266742407202] &lt;= 1.2 THEN 2&#13;&#10;ELSE 3&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[EmployeeCount]' role='measure' type='quantitative' />
            <column datatype='integer' name='[JobLevel]' role='measure' type='quantitative' />
            <column datatype='integer' name='[MonthlyIncome]' role='measure' type='quantitative' />
            <column datatype='integer' name='[YearsAtCompany]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2118266743230500]' derivation='Avg' name='[avg:Calculation_2118266743230500:qk]' pivot='key' type='quantitative' />
