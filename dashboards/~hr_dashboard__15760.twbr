          <datasource-dependencies datasource='federated.1vb3wkh14cl6ws15iny691sp7f6z'>
            <column caption='Q_Sort' datatype='string' name='[Calculation_2118266744614949]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [PercentSalaryHike] &gt;= {FIXED: AVG([PercentSalaryHike])} &#13;&#10;AND [TotalWorkingYears] &gt;= {FIXED: AVG([TotalWorkingYears])} &#13;&#10;THEN &quot;Q2: Core Talent (Kinh nghiệm Cao - Tăng lương Cao)&quot;&#13;&#10;&#13;&#10;ELSEIF [PercentSalaryHike] &lt; {FIXED: AVG([PercentSalaryHike])} &#13;&#10;AND [TotalWorkingYears] &gt;= {FIXED: AVG([TotalWorkingYears])} &#13;&#10;THEN &quot;Q1: Flight Risk (Kinh nghiệm Cao - Tăng lương Thấp)&quot;&#13;&#10;&#13;&#10;ELSEIF [PercentSalaryHike] &gt;= {FIXED: AVG([PercentSalaryHike])} &#13;&#10;AND [TotalWorkingYears] &lt; {FIXED: AVG([TotalWorkingYears])} &#13;&#10;THEN &quot;Q4: Rising Star (Kinh nghiệm Thấp - Tăng lương Cao)&quot;&#13;&#10;&#13;&#10;ELSE &quot;Q3: Developing (Kinh nghiệm Thấp - Tăng lương Thấp)&quot;&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[EmployeeNumber]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[PercentSalaryHike]' role='measure' type='quantitative' />
            <column datatype='integer' name='[TotalWorkingYears]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2118266744614949]' derivation='None' name='[none:Calculation_2118266744614949:nk]' pivot='key' type='nominal' />
            <column-instance column='[EmployeeNumber]' derivation='None' name='[none:EmployeeNumber:ok]' pivot='key' type='ordinal' />
            <column-instance column='[PercentSalaryHike]' derivation='Sum' name='[sum:PercentSalaryHike:qk]' pivot='key' type='quantitative' />
            <column-instance column='[TotalWorkingYears]' derivation='Sum' name='[sum:TotalWorkingYears:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
