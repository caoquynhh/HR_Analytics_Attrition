      <aliases enabled='yes' />
      <column caption='Attrition count' datatype='integer' name='[Calculation_2118265449402368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Attrition] = &apos;Yes&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Active Employees' datatype='integer' name='[Calculation_2118265449734145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([EmployeeCount])-SUM([Calculation_2118265449402368])' />
      </column>
      <column caption='Attrition rate' datatype='real' name='[Calculation_2118265450119170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2118265449402368])/SUM([EmployeeCount])' />
      </column>
      <column caption='Group Age' datatype='string' name='[Calculation_2118265450332163]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt;= 25 THEN &quot;18-25&quot;&#13;&#10;ELSEIF [Age] &lt;= 35 THEN &quot;26-35&quot;&#13;&#10;ELSEIF [Age] &lt;= 45 THEN &quot;36-45&quot;&#13;&#10;ELSEIF [Age] &lt;= 55 THEN &quot;46-55&quot;&#13;&#10;ELSE &quot;56-60&quot;&#13;&#10;END' />
      </column>
      <column caption='Education Level' datatype='string' name='[Calculation_2118265456844804]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Education]&#13;&#10;    WHEN 1 THEN &quot;Below College&quot;&#13;&#10;    WHEN 2 THEN &quot;College&quot;&#13;&#10;    WHEN 3 THEN &quot;Bachelor&quot;&#13;&#10;    WHEN 4 THEN &quot;Master&quot;&#13;&#10;    WHEN 5 THEN &quot;Doctor&quot;&#13;&#10;END' />
      </column>
      <column caption='Attrition_Male' datatype='integer' name='[Calculation_2118265460289542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Gender] = &quot;Male&quot; THEN [Calculation_2118265449402368] ELSE 0 END' />
      </column>
      <column caption='Attrition_Female' datatype='integer' name='[Calculation_2118265460502535]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Gender] = &quot;Female&quot; THEN [Calculation_2118265449402368] ELSE 0 END' />
      </column>
      <column caption='zero' datatype='integer' name='[Calculation_2118265472045066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='DisFromHome' datatype='string' name='[Calculation_2118265480650763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [DistanceFromHome] &lt;= 5 THEN &quot;0-5 miles&quot;&#13;&#10;ELSEIF [DistanceFromHome] &lt;= 10 THEN &quot;6-10 miles&quot;&#13;&#10;ELSEIF [DistanceFromHome] &lt;= 15 THEN &quot;11-15 miles&quot;&#13;&#10;ELSEIF [DistanceFromHome] &lt;= 20 THEN &quot;16-20 miles&quot;&#13;&#10;ELSE &quot;21+ miles&quot;&#13;&#10;END' />
      </column>
      <column caption=' Years at Company Group' datatype='string' name='[Calculation_2118265574985740]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [YearsAtCompany] &lt;= 1 then &quot;0-1 years&quot;&#13;&#10;ELSEIF [YearsAtCompany] &lt;= 3 then &quot;1-3 years&quot;&#13;&#10;ELSEIF [YearsAtCompany] &lt;= 5 then &quot;3-5 years&quot;&#13;&#10;ELSEIF [YearsAtCompany] &lt;= 10 then &quot;5-10 years&quot;&#13;&#10;ELSE &quot;10+ years&quot;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Satisfaction Level' datatype='integer' name='[Calculation_2118265588195341]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;EnvironmentSatisfaction&quot; THEN [EnvironmentSatisfaction]&#13;&#10;    WHEN &quot;RelationshipSatisfaction&quot; THEN [RelationshipSatisfaction]&#13;&#10;    WHEN &quot;JobSatisfaction&quot; THEN [JobSatisfaction]&#13;&#10;    WHEN &quot;WorkLifeBalance&quot; THEN [WorkLifeBalance]&#13;&#10;&#13;&#10;END' />
        <aliases>
          <alias key='1' value='Low' />
          <alias key='2' value='Medium' />
          <alias key='3' value='High' />
          <alias key='4' value='Very High' />
        </aliases>
      </column>
      <column caption='OT&amp;BT' datatype='string' name='[Calculation_2118266365018127]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Overtime&quot; THEN [OverTime]&#13;&#10;ELSE [BusinessTravel]&#13;&#10;END' />
      </column>
      <column caption='Show Group Age' datatype='string' name='[Calculation_2118266372550672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = [MaritalStatus] THEN [Calculation_2118265450332163] ELSE &quot;&quot; END' />
      </column>
      <column caption='FIXED_TotalAttrition' datatype='integer' name='[Calculation_2118266375790609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [MaritalStatus] : SUM([Calculation_2118265449402368])}' />
      </column>
      <column caption='%Attrition count' datatype='real' name='[Calculation_2118266376216594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2118265449402368] / [Calculation_2118266375790609]' />
      </column>
      <column caption='EF,EL,DE' datatype='string' name='[Calculation_2118266512437267]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;Education Level&quot; THEN [Calculation_2118265456844804]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Education Field&quot; THEN [EducationField]&#13;&#10;ELSE [Department]&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='JOBINVOLVE&amp;PERRATING' datatype='integer' name='[Calculation_2118266546249748]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &quot;Jobinvolvement&quot; THEN [JobInvolvement]&#13;&#10;ELSE [PerformanceRating]&#13;&#10;END' />
      </column>
      <column caption='Jobinvolve&amp;Perrating' datatype='integer' name='[Calculation_2118266551025685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &quot;Jobinvolvemnet&quot; THEN [JobInvolvement]&#13;&#10;ELSE [PerformanceRating]&#13;&#10;END' />
      </column>
      <column caption='YearsInCurrentRole_Binned' datatype='string' name='[Calculation_2118266631954454]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [YearsInCurrentRole] &lt; 1 THEN &quot;0-1&quot;&#13;&#10;ELSEIF [YearsInCurrentRole] &gt;= 1 AND [YearsInCurrentRole] &lt; 3 THEN &quot;1-3&quot;&#13;&#10;ELSEIF [YearsInCurrentRole] &gt;= 3 AND [YearsInCurrentRole] &lt; 5 THEN &quot;3-5&quot;&#13;&#10;ELSEIF [YearsInCurrentRole] &gt;= 5 AND [YearsInCurrentRole] &lt; 10 THEN &quot;5-10&quot;&#13;&#10;ELSE &quot;&gt;=10&quot;&#13;&#10;END' />
      </column>
      <column caption='GA&amp;DFH' datatype='string' name='[Calculation_2118266641313817]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &quot;Group Age&quot;&#13;&#10;THEN [Calculation_2118265450332163]&#13;&#10;ELSE [Calculation_2118265480650763]&#13;&#10;END' />
      </column>
      <column caption='Midpoint_JobLevel' datatype='real' name='[Calculation_2118266742251553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [JobLevel] : MEDIAN([MonthlyIncome])}' />
      </column>
      <column caption='Compa_Ratio' datatype='real' name='[Calculation_2118266742407202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[MonthlyIncome]/[Calculation_2118266742251553]' />
      </column>
      <column caption='Compa_Ratio_Group' datatype='string' name='[Calculation_2118266742579235]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2118266742407202] &lt; 0.8 THEN &quot;Below Standard&quot;&#13;&#10;ELSEIF [Calculation_2118266742407202] &lt;= 1.2 THEN &quot;Competitive&quot;&#13;&#10;ELSE &quot;Above Standard&quot;&#13;&#10;END' />
      </column>
      <column caption='Compa_Ratio_Group_Sort' datatype='integer' name='[Calculation_2118266743230500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2118266742407202] &lt; 0.8 THEN 1&#13;&#10;ELSEIF [Calculation_2118266742407202] &lt;= 1.2 THEN 2&#13;&#10;ELSE 3&#13;&#10;END' />
      </column>
      <column caption='Q_Sort' datatype='string' name='[Calculation_2118266744614949]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [PercentSalaryHike] &gt;= {FIXED: AVG([PercentSalaryHike])} &#13;&#10;AND [TotalWorkingYears] &gt;= {FIXED: AVG([TotalWorkingYears])} &#13;&#10;THEN &quot;Q2: Core Talent (Kinh nghiệm Cao - Tăng lương Cao)&quot;&#13;&#10;&#13;&#10;ELSEIF [PercentSalaryHike] &lt; {FIXED: AVG([PercentSalaryHike])} &#13;&#10;AND [TotalWorkingYears] &gt;= {FIXED: AVG([TotalWorkingYears])} &#13;&#10;THEN &quot;Q1: Flight Risk (Kinh nghiệm Cao - Tăng lương Thấp)&quot;&#13;&#10;&#13;&#10;ELSEIF [PercentSalaryHike] &gt;= {FIXED: AVG([PercentSalaryHike])} &#13;&#10;AND [TotalWorkingYears] &lt; {FIXED: AVG([TotalWorkingYears])} &#13;&#10;THEN &quot;Q4: Rising Star (Kinh nghiệm Thấp - Tăng lương Cao)&quot;&#13;&#10;&#13;&#10;ELSE &quot;Q3: Developing (Kinh nghiệm Thấp - Tăng lương Thấp)&quot;&#13;&#10;END' />
      </column>
      <column caption='X-axis variable' datatype='integer' name='[Calculation_2118266745819174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#13;&#10;WHEN &quot;Age&quot; THEN [Age]&#13;&#10;WHEN &quot;TotalWorkingYears&quot; THEN [TotalWorkingYears]&#13;&#10;WHEN &quot;YearsAtCompany&quot; THEN [YearsAtCompany]&#13;&#10;END' />
      </column>
      <column caption='Average Salary Hike' datatype='real' name='[Calculation_2118266859560999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([PercentSalaryHike]) / 100' />
      </column>
      <column caption='PercentSalaryHike_%' datatype='real' name='[Calculation_2118266886770728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[PercentSalaryHike]/100' />
      </column>
