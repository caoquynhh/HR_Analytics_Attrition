    <worksheet name='EmployeeCount by MaritalStatus and Group Age'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#f1ce63' fontname='Tableau Bold' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='WA_Fn-UseC_-HR-Employee-Attriti (Data sau xử lý)' name='federated.1vb3wkh14cl6ws15iny691sp7f6z' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Satisfaction Factor' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;WorkLifeBalance&quot;'>
              <calculation class='tableau' formula='&quot;WorkLifeBalance&quot;' />
            </column>
            <column caption='Select MartalStatus' datatype='string' name='[Parameter 3]' param-domain-type='any' role='measure' type='nominal' value='&quot;Married&quot;'>
              <calculation class='tableau' formula='&quot;Married&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vb3wkh14cl6ws15iny691sp7f6z'>
            <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
            <column caption='Group Age' datatype='string' name='[Calculation_2118265450332163]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Age] &lt;= 25 THEN &quot;18-25&quot;&#13;&#10;ELSEIF [Age] &lt;= 35 THEN &quot;26-35&quot;&#13;&#10;ELSEIF [Age] &lt;= 45 THEN &quot;36-45&quot;&#13;&#10;ELSEIF [Age] &lt;= 55 THEN &quot;46-55&quot;&#13;&#10;ELSE &quot;56-60&quot;&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Satisfaction Level' datatype='integer' name='[Calculation_2118265588195341]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;EnvironmentSatisfaction&quot; THEN [EnvironmentSatisfaction]&#13;&#10;    WHEN &quot;RelationshipSatisfaction&quot; THEN [RelationshipSatisfaction]&#13;&#10;    WHEN &quot;JobSatisfaction&quot; THEN [JobSatisfaction]&#13;&#10;    WHEN &quot;WorkLifeBalance&quot; THEN [WorkLifeBalance]&#13;&#10;&#13;&#10;END' />
