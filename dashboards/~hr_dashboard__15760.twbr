                <alias key='1' value='Low' />
                <alias key='2' value='Medium' />
                <alias key='3' value='High' />
                <alias key='4' value='Very High' />
              </aliases>
            </column>
            <column caption='Show Group Age' datatype='string' name='[Calculation_2118266372550672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = [MaritalStatus] THEN [Calculation_2118265450332163] ELSE &quot;&quot; END' />
            </column>
            <column datatype='integer' name='[EmployeeCount]' role='measure' type='quantitative' />
            <column datatype='integer' name='[EnvironmentSatisfaction]' role='measure' type='quantitative' />
            <column datatype='integer' name='[JobSatisfaction]' role='measure' type='quantitative' />
