            <column-instance column='[Calculation_2118266372550672]' derivation='None' name='[none:Calculation_2118266372550672:nk]' pivot='key' type='nominal' />
            <column-instance column='[MaritalStatus]' derivation='None' name='[none:MaritalStatus:nk]' pivot='key' type='nominal' />
